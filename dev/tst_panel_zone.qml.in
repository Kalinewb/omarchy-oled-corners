import QtQuick
import QtTest
import "file://@REPO@" as Corners

TestCase {
  id: tc
  name: "PanelZone"
  width: 400
  height: 300
  visible: true
  when: windowShown

  QtObject {
    id: strip
    readonly property var features: ["panel", "panelBack", "backZone"]
    readonly property color color: "#000000"
    readonly property color foreground: "#ffffff"
    readonly property color secondary: "#aaaaaa"
    readonly property color accent: "#ffffff"
    readonly property string fontFamily: ""
    readonly property real backZoneWidth: 180
    readonly property real backZoneHeight: 32
    readonly property real restHeight: 32
    function radiusFor(size) { return 6 }
  }
  QtObject {
    id: plain
    readonly property var features: ["panel"]
    readonly property color color: "#000000"
    readonly property color foreground: "#ffffff"
    readonly property color secondary: "#aaaaaa"
    readonly property color accent: "#ffffff"
    readonly property string fontFamily: ""
    function radiusFor(size) { return 6 }
  }
  QtObject {
    id: stub
    property var screenNames: ["eDP-1"]
    property bool writable: true
    property bool loaded: true
    function radiusOf(m) { return -1 }
    function followRadius(m) { return 10 }
    function nudge(m, d) {}
    function follow(m) {}
  }

  Component { id: make; Corners.CornersPanel { integration: stub; width: 420 } }

  function press(item, hits) {
    // Everything under `item` that takes a press and overlaps the zone (a 180 x 32 band at the top centre).
    var zone = { x: (item.width - 180) / 2, y: 0, w: 180, h: 32 }
    function walk(i) {
      if (!i || !i.visible) return
      var at = i.mapToItem(item, 0, 0)
      if (i.acceptedButtons !== undefined && i.acceptedButtons !== 0 && i.width > 0 && i.height > 0
          && at.x < zone.x + zone.w && at.x + i.width > zone.x && at.y < zone.h && at.y + i.height > 0) hits.push(at.x + "," + at.y)
      for (var k = 0; k < i.children.length; k++) walk(i.children[k])
    }
    walk(item)
  }
  function texts(item, out) {
    if (!item || !item.visible) return
    // Painted text only: a UTip carries its `text` whether or not it is showing.
    if (typeof item.text === "string" && item.text !== "" && item.contentWidth !== undefined) out.push(item.text)
    for (var k = 0; k < item.children.length; k++) texts(item.children[k], out)
  }

  function find(item, text) {
    if (!item) return null
    if (item.text === text && item.contentWidth !== undefined) return item
    for (var k = 0; k < item.children.length; k++) {
      var hit = find(item.children[k], text)
      if (hit) return hit
    }
    return null
  }
  function named(item, name, out) {
    if (!item) return
    if (item.Accessible !== undefined && item.Accessible.name === name && item.activeFocusOnTab) out.push(item)
    for (var k = 0; k < item.children.length; k++) named(item.children[k], name, out)
  }

  function test_01_under_a_strip_nothing_is_pushed_down_and_the_heading_ends_before_the_zone() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var heading = find(p, "OLED corners")
    verify(heading !== null)
    // The header is at the top, as tall as the zone and no taller: the first row starts where the zone ends.
    var at = heading.parent.mapToItem(p, 0, 0)
    compare(Math.round(at.y), 0)
    compare(Math.round(heading.parent.height), 32)
    verify(heading.implicitWidth <= heading.width, "the whole heading fits in the room beside the zone, unelided")
    var glyphs = heading.mapToItem(p, 0, 0).x + heading.contentWidth
    verify(glyphs <= (p.width - 180) / 2, "its glyphs end before the zone starts")
  }
  function test_01b_no_text_paints_in_the_zone() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var zone = { x: (p.width - 180) / 2, w: 180, h: 32 }
    var found = []
    function walk(i) {
      if (!i || !i.visible) return
      if (typeof i.text === "string" && i.text !== "" && i.contentWidth !== undefined) {
        var at = i.mapToItem(p, 0, 0)
        var cw = Math.min(i.contentWidth, i.width)
        var off = i.effectiveHorizontalAlignment === Qt.AlignRight ? i.width - cw : i.effectiveHorizontalAlignment === Qt.AlignHCenter ? (i.width - cw) / 2 : 0
        if (at.x + off < zone.x + zone.w && at.x + off + cw > zone.x && at.y < zone.h && at.y + i.height > 0) found.push(i.text + "@" + Math.round(at.x + off) + "," + Math.round(at.y))
      }
      for (var k = 0; k < i.children.length; k++) walk(i.children[k])
    }
    walk(p)
    compare(found.join(" | "), "")
  }
  function test_02_no_esc_close_hint_is_drawn_and_the_keys_are_named_in_a_tip() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var all = []
    texts(p, all)
    compare(all.join("|").indexOf("Esc"), -1)
    // The keys that are not obvious (F, Backspace) stay, in the tip on the foot line: it arms 250 ms after focus.
    tryVerify(function () { var t = []; texts(p, t); return t.join("|").indexOf("follow the level above") !== -1 }, 2000, "the tip names F")
    var tip = []
    texts(p, tip)
    compare(tip.join("|").indexOf("Esc"), -1, "and the tip does not mention Esc either")
  }
  function test_03_nothing_that_takes_a_press_is_in_the_zone() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var hits = []
    press(p, hits)
    compare(hits.join(" "), "")
  }
  function test_04_the_strips_first_press_is_answered_no() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    compare(p.goBackInside(), false)
  }
  function test_05_with_no_strip_there_is_no_zone_and_the_heading_has_its_full_width() {
    var p = createTemporaryObject(make, tc, { surfaceHost: plain })
    var heading = find(p, "OLED corners")
    compare(Math.round(heading.parent.mapToItem(p, 0, 0).y), 0)
    verify(heading.width > p.width / 2, "not held to the room beside a zone that is not there")
    compare(p.zoneWidth, 0)
  }
  function test_06b_one_close_and_no_back_of_our_own() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var closes = [], backs = []
    named(p, "Close", closes)
    named(p, "Back", backs)
    compare(closes.length, 1, "one close, at the top right")
    compare(backs.length, 0, "the strip is the one back; this page draws none")
    var at = closes[0].mapToItem(p, 0, 0)
    verify(at.x >= (p.width + 180) / 2, "the close is right of the zone")
  }
  function test_06_esc_still_closes() {
    var p = createTemporaryObject(make, tc, { surfaceHost: strip })
    var closed = 0
    p.closeRequested.connect(function () { closed++ })
    p.forceActiveFocus()
    keyClick(Qt.Key_Escape)
    compare(closed, 1)
  }
}
