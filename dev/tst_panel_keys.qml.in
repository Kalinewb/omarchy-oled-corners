import QtQuick
import QtTest
import "file://@REPO@" as Corners

// The keys of the settings panel, and what each one writes. The stand-in for
// Surface.qml records every call the panel makes (nudge, follow), so "the same
// keys write the same settings" is checked against that record, not against
// how the rows look.
TestCase {
  id: tc
  name: "PanelKeys"
  width: 420
  height: 300
  visible: true
  when: windowShown

  QtObject {
    id: host
    readonly property var features: ["panel", "panelBack", "backZone"]
    readonly property color color: "#000000"
    readonly property color foreground: "#ffffff"
    readonly property color secondary: "#aaaaaa"
    readonly property color accent: "#ffffff"
    readonly property string fontFamily: ""
    readonly property real backZoneWidth: 180
    readonly property real backZoneHeight: 32
    readonly property real restHeight: 32
    function radiusFor(size) { return 6 }
  }
  QtObject {
    id: stub
    property var screenNames: ["eDP-1", "DP-2"]
    property bool writable: true
    property bool loaded: true
    property var calls: []
    property var radii: ({})
    function radiusOf(m) { return radii[m] !== undefined ? radii[m] : (m === "DP-2" ? 28 : -1) }
    function followRadius(m) { return 10 }
    function nudge(m, d) { calls = calls.concat(["nudge " + (m || "all") + " " + d]) }
    function follow(m) { calls = calls.concat(["follow " + (m || "all")]) }
  }

  Component { id: make; Corners.CornersPanel { integration: stub; surfaceHost: host; width: 420 } }

  function init() { stub.calls = []; stub.radii = ({}); stub.screenNames = ["eDP-1", "DP-2"] }
  function panel() {
    var p = createTemporaryObject(make, tc)
    p.forceActiveFocus()
    verify(p.activeFocus, "the panel takes the keyboard")
    return p
  }

  function test_01_three_rows_and_the_first_is_selected() {
    var p = panel()
    compare(p.rows.length, 3)
    compare(p.rows[0].monitor, "")
    compare(p.rows[1].monitor, "eDP-1")
    compare(p.selected, 0)
  }
  function test_02_left_and_right_step_the_selected_row() {
    var p = panel()
    keyClick(Qt.Key_Right)
    keyClick(Qt.Key_Left)
    keyClick(Qt.Key_Left)
    compare(stub.calls.join("|"), "nudge all 1|nudge all -1|nudge all -1")
  }
  function test_03_down_and_up_move_between_rows_and_stop_at_the_ends() {
    var p = panel()
    keyClick(Qt.Key_Up)
    compare(p.selected, 0)
    keyClick(Qt.Key_Down)
    compare(p.selected, 1)
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Down)
    compare(p.selected, 2)
    keyClick(Qt.Key_Up)
    compare(p.selected, 1)
  }
  function test_04_the_arrows_act_on_the_row_that_is_selected() {
    var p = panel()
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Right)
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Left)
    compare(stub.calls.join("|"), "nudge eDP-1 1|nudge DP-2 -1")
  }
  function test_05_f_hands_the_row_back() {
    var p = panel()
    keyClick(Qt.Key_F)
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_F)
    compare(stub.calls.join("|"), "follow all|follow eDP-1")
  }
  function test_06_backspace_does_the_same() {
    var p = panel()
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Backspace)
    compare(stub.calls.join("|"), "follow DP-2")
  }
  function test_07_esc_closes() {
    var p = panel()
    var closed = 0
    p.closeRequested.connect(function () { closed++ })
    keyClick(Qt.Key_Escape)
    compare(closed, 1)
    compare(stub.calls.length, 0, "and writes nothing")
  }
  function test_08_other_keys_do_nothing() {
    var p = panel()
    keyClick(Qt.Key_G)
    keyClick(Qt.Key_Space)
    keyClick(Qt.Key_Return)
    keyClick(Qt.Key_Delete)
    compare(stub.calls.length, 0)
    compare(p.selected, 0)
  }
  function test_09_a_monitor_unplugged_keeps_the_selection_in_range() {
    var p = panel()
    keyClick(Qt.Key_Down)
    keyClick(Qt.Key_Down)
    compare(p.selected, 2)
    stub.screenNames = ["eDP-1"]
    compare(p.rows.length, 2)
    compare(p.selected, 1)
    keyClick(Qt.Key_Right)
    compare(stub.calls.join("|"), "nudge eDP-1 1")
  }
  function test_10_a_new_open_starts_on_all_monitors() {
    var p = panel()
    keyClick(Qt.Key_Down)
    compare(p.selected, 1)
    p.open("main")
    compare(p.selected, 0)
  }
  function test_11_without_an_integration_the_keys_write_nothing_and_do_not_throw() {
    var p = createTemporaryObject(make, tc, { integration: null })
    p.forceActiveFocus()
    keyClick(Qt.Key_Right)
    keyClick(Qt.Key_F)
    keyClick(Qt.Key_Down)
    compare(p.selected, 0, "only the global row exists")
  }

  // ---- what the kit adds (the unchanged 1.1.0 panel had none of this: no tip to dismiss, no tab stops)

  function all(item, out) {
    if (!item || !item.visible) return
    if (item.activeFocusOnTab) out.push(item)
    for (var k = 0; k < item.children.length; k++) all(item.children[k], out)
  }
  function byName(p, name) {
    var found = []
    all(p, found)
    for (var i = 0; i < found.length; i++) if (found[i].Accessible.name === name) return found[i]
    return null
  }
  function texts(item, out) {
    if (!item || !item.visible) return
    // Painted text only: a UTip carries its `text` whether or not it is showing.
    if (typeof item.text === "string" && item.text !== "" && item.contentWidth !== undefined) out.push(item.text)
    for (var k = 0; k < item.children.length; k++) texts(item.children[k], out)
  }
  function withName(item, name, out) {
    if (!item || !item.visible) return
    if (item.Accessible !== undefined && item.Accessible.name === name) out.push(item)
    for (var k = 0; k < item.children.length; k++) withName(item.children[k], name, out)
  }

  function test_12_esc_dismisses_the_tip_before_it_closes() {
    var p = panel()
    var closed = 0
    p.closeRequested.connect(function () { closed++ })
    tryVerify(function () { var t = []; texts(p, t); return t.join("|").indexOf("follow the level above") !== -1 }, 2000, "the tip arms on focus")
    keyClick(Qt.Key_Escape)
    compare(closed, 0, "the first Esc puts the tip away")
    keyClick(Qt.Key_Escape)
    compare(closed, 1, "the second closes")
  }
  function test_13_each_row_has_a_stepper_and_a_follow_button_that_tab_reaches() {
    var p = panel()
    var stops = []
    all(p, stops)
    var names = stops.map(function (i) { return i.Accessible.name })
    // A Follow that has nothing to hand back is disabled, and a disabled control is not a tab stop.
    compare(names.join("|"), "Close|All monitors radius 10 px|eDP-1 radius 10 px|DP-2 radius 28 px|Follow")
  }
  function test_14_follow_is_off_for_a_row_that_already_follows_and_on_for_one_that_has_a_value() {
    var p = panel()
    var follows = []
    withName(p, "Follow", follows)
    compare(follows.length, 3)
    compare(follows[0].enabled, false)
    compare(follows[1].enabled, false)
    compare(follows[2].enabled, true)
    follows[2].clicked()
    compare(stub.calls.join("|"), "follow DP-2")
    compare(p.selected, 2)
  }
  function test_15_the_minus_and_plus_cells_pick_their_row_and_step_it() {
    var p = panel()
    var step = byName(p, "DP-2 radius 28 px")
    verify(step !== null)
    mouseClick(step, step.width - 10, step.height / 2)
    compare(stub.calls.join("|"), "nudge DP-2 1")
    compare(p.selected, 2)
    mouseClick(step, 10, step.height / 2)
    compare(stub.calls.join("|"), "nudge DP-2 1|nudge DP-2 -1")
  }
  function test_16_clicking_a_row_picks_it_and_the_keyboard_follows() {
    var p = panel()
    var row = byName(p, "eDP-1 radius 10 px")
    var at = row.mapToItem(p, 0, 0)
    mouseClick(p, at.x - 60, at.y + row.height / 2)
    compare(p.selected, 1)
    compare(row.activeFocus, true)
    keyClick(Qt.Key_Right)
    compare(stub.calls.join("|"), "nudge eDP-1 1")
  }
  function test_17_the_stepper_does_not_go_past_its_ends() {
    var p = panel()
    stub.radii = { "": 0 }
    var step = byName(p, "All monitors radius 0 px")
    verify(step !== null)
    keyClick(Qt.Key_Left)
    compare(stub.calls.length, 0, "at 0 there is nothing lower to write")
    stub.radii = {}
  }
}

